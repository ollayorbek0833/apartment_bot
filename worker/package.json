{
  "name": "apartmentmate-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ApartmentMate on Cloudflare Workers: grammY webhook, D1 storage, Cron Triggers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply apartmentmate --local",
    "db:remote": "wrangler d1 migrations apply apartmentmate --remote"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
